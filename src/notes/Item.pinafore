import "notes/World";
namespace Item {
    let {
        entitytype Type;
        entitytype Value;

        datatype storable Item. {
            Mk Type Value !"Item.pinafore-notes";
        };

        new: Type -> Action Item =
            fn t => do {
                v <- !{new.OpenEntity @Value};
                pure $ Mk t v;
            };

        isType: Type -> Item -> Boolean =
            fn t, Mk ti _ => t == ti;
    } expose Item, Type, new, isType;

    all: FiniteSetModel Item =
            !{property @Item @World !"Item-World.pinafore-notes"} ?store !@ world;

    nameOf: Property Item Text =
        !{property @Item @Text !"name.pinafore-notes"} ?store;
};
